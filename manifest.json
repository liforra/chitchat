{
  "manifest_version": 3,
  "name": "ChitChat Theme",
  "version": "1.11.0",
  "description": "Shades of purple theme and extension controls for ChitChat.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chitchat-theme@liforra.de",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/liforra/chitchat/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["browsingActivity", "personalCommunications"]
      }
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.chitchat.gg/*"],
      "js": ["markdown.js", "linkinfo.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.chitchat.gg/*",
    "https://*.liforra.de/*",
    "https://www.youtube.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["theme.css"],
      "matches": ["*://*.chitchat.gg/*"]
    }
  ]
}